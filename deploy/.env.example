# Copy to deploy/.env on the server and fill in every value. Never commit the real file.
#   cp .env.example .env && chmod 600 .env

# The address the app talks to, with no https:// in front. Its DNS A record must point at this server.
API_DOMAIN=api.example.com

# Generate each secret with:  openssl rand -base64 36
POSTGRES_PASSWORD=
JWT_SECRET=

# Outgoing email: sign-in codes. Any SMTP provider works. Two ready-made sets of values:
#
#   Resend  SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true   SMTP_USER=resend            SMTP_PASS=<your Resend API key>
#   Brevo   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false  SMTP_USER=<your Brevo SMTP login>  SMTP_PASS=<your Brevo SMTP key>
#
# SMTP_SECURE is true only for port 465. Port 587 starts plain and upgrades to TLS, and the API refuses to send if it cannot.
# MAIL_FROM must be an address on the domain you verified with the provider.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Ricochet <no-reply@example.com>

# Files (voice and video notes, photos) are kept on this server's disk. See docs/deploying-aws.md before changing this.
MEDIA_PROVIDER=local

# expo sends real push notifications. log only writes them to the log.
PUSH_PROVIDER=expo

# Optional: an S3 location for the nightly database copy, for example s3://my-ricochet-backups/db
BACKUP_S3_URI=
