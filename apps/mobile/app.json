{
  "expo": {
    "name": "Ricochet",
    "slug": "ricochet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ricochet",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#e9714e",
    "ios": {
      "bundleIdentifier": "me.adeyemiabiade.ricochet",
      "supportsTablet": false
    },
    "android": {
      "package": "me.adeyemiabiade.ricochet",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#e9714e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e9714e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 1
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ricochet uses your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Ricochet uses the microphone to record voice notes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ricochet uses the camera to record video notes.",
          "microphonePermission": "Ricochet uses the microphone to record voice and video notes.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#e9714e"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
