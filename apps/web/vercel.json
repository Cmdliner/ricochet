{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @ricochet/web...",
  "buildCommand": "cd ../.. && pnpm --filter @ricochet/shared build && pnpm --filter @ricochet/web build",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../../packages/shared ../../pnpm-lock.yaml ../../pnpm-workspace.yaml ../../package.json"
}
