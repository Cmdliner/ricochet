# Copy to .env at the repo root. The API and the database tools both read it.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://ricochet:ricochet@localhost:5442/ricochet
REDIS_URL=redis://localhost:6380

# Signs sign-in tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Outgoing email. In development this is the Mailpit container: open http://localhost:8025 to read the codes.
# In production point these at any SMTP provider (Resend, Postmark, Amazon SES, and so on).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Ricochet <no-reply@ricochet.local>

# Only needed if you change the host ports in docker-compose.yml (and then update the URLs above).
# POSTGRES_PORT=5442
# REDIS_PORT=6380
