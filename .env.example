# Copy to .env at the repo root. The API and the database tools both read it.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://ricochet:ricochet@localhost:5442/ricochet
REDIS_URL=redis://localhost:6380

# Only needed if you change the host ports in docker-compose.yml (and then update the URLs above).
# POSTGRES_PORT=5442
# REDIS_PORT=6380
