# Copy to .env at the repo root. The API and the database tools both read it.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://ricochet:ricochet@localhost:5442/ricochet
REDIS_URL=redis://localhost:6380

# Signs sign-in tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Outgoing email. In development this is the Mailpit container: open http://localhost:8025 to read the codes.
# In production point these at any SMTP provider (Resend, Postmark, Amazon SES, and so on).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Ricochet <no-reply@ricochet.local>

# File storage for avatars and voice and video notes.
#   local: files are kept on this server's disk (apps/api/.media). Nothing to set up. Use this for development.
#   r2:    Cloudflare R2. Create two buckets, attach a public domain to the public one, and create an API token
#          with read and write access to both. R2_PUBLIC_URL is that public domain.
MEDIA_PROVIDER=local
# MEDIA_LOCAL_DIR=./.media
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=ricochet-public
# R2_PRIVATE_BUCKET=ricochet-private
# R2_PUBLIC_URL=https://media.example.com

# Only needed if you change the host ports in docker-compose.yml (and then update the URLs above).
# POSTGRES_PORT=5442
# REDIS_PORT=6380
