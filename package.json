{
  "name": "ricochet",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @ricochet/web dev",
    "dev:api": "pnpm --filter @ricochet/api start:dev",
    "dev:mobile": "pnpm --filter @ricochet/mobile start",
    "dev:mobile:lan": "pnpm --filter @ricochet/mobile start:lan",
    "dev:packages": "pnpm --parallel --filter \"./packages/*\" dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ricochet/db generate",
    "db:migrate": "pnpm --filter @ricochet/db migrate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
